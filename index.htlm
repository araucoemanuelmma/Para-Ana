<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Para Anahí 💕</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    font-family: 'Segoe UI', sans-serif;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #ff9a9e, #fad0c4, #fbc2eb);
    padding: 20px;
    overflow: hidden;
  }
  .card {
    background: #fff;
    border-radius: 24px;
    padding: 40px 30px;
    max-width: 420px;
    width: 100%;
    text-align: center;
    box-shadow: 0 20px 50px rgba(0,0,0,0.15);
    animation: aparecer .6s ease;
    position: relative;
    z-index: 2;
  }
  @keyframes aparecer {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  h1 { font-size: 1.6rem; color: #d6336c; margin-bottom: 10px; }
  .emoji { font-size: 3rem; margin-bottom: 15px; }
  p { color: #555; margin-bottom: 25px; }
  .botones { display: flex; gap: 12px; justify-content: center; }
  button {
    padding: 14px 28px;
    border: none;
    border-radius: 50px;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: transform .2s;
    font-family: inherit;
  }
  button:hover { transform: scale(1.05); }
  .si {
    background: linear-gradient(135deg, #ff6b9d, #d6336c);
    color: #fff;
    box-shadow: 0 6px 18px rgba(214,51,108,0.4);
  }
  .no { background: #eee; color: #666; }
  .respuesta { display: none; animation: aparecer .5s ease; }
  .respuesta.show { display: block; }
  .respuesta h2 { font-size: 1.8rem; color: #d6336c; margin-bottom: 10px; }
  .respuesta .corazon { font-size: 4rem; animation: latir 1s infinite; }
  @keyframes latir {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.15); }
  }
  .musica-btn {
    position: fixed;
    top: 20px;
    right: 20px;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: #fff;
    border: none;
    font-size: 1.4rem;
    cursor: pointer;
    box-shadow: 0 6px 18px rgba(0,0,0,0.15);
    z-index: 10;
    display: none;
  }
  .musica-btn.show { display: block; }
  .corazon-flotante {
    position: fixed;
    bottom: -50px;
    font-size: 24px;
    animation: subir 6s linear infinite;
    pointer-events: none;
    z-index: 1;
  }
  @keyframes subir {
    from { transform: translateY(0) rotate(0deg); opacity: 1; }
    to   { transform: translateY(-110vh) rotate(360deg); opacity: 0; }
  }
</style>
</head>
<body>

  <button class="musica-btn" id="musicaBtn" onclick="toggleMusica()">🔊</button>

  <div class="card">
    <div id="pregunta">
      <div class="emoji">💌</div>
      <h1>¿Quieres ser mi novia, Anahí?</h1>
      <p>Piensa bien tu respuesta... 👀</p>
      <div class="botones">
        <button class="si" onclick="responder('si')">Sí 💖</button>
        <button class="no" onclick="responder('no')">No 😢</button>
      </div>
    </div>

    <div class="respuesta" id="respuesta">
      <div class="corazon">💖</div>
      <h2 id="tituloRespuesta"></h2>
      <p id="textoRespuesta"></p>
    </div>
  </div>

  <audio id="musica" loop preload="auto">
    <source src="quimica-mayor.mp3" type="audio/mpeg">
    Tu navegador no soporta audio.
  </audio>

<script>
  const musica = document.getElementById('musica');

  function responder(opcion) {
    const pregunta = document.getElementById('pregunta');
    const respuesta = document.getElementById('respuesta');
    const titulo = document.getElementById('tituloRespuesta');
    const texto = document.getElementById('textoRespuesta');

    if (opcion === 'si') {
      titulo.textContent = 'Sabía que querías, Ana 💕';
      texto.textContent = 'Te quiero mucho, Anahí 🥰';

      musica.volume = 0.6;
      musica.play().catch(err => console.log('Error:', err));

      document.getElementById('musicaBtn').classList.add('show');
      lanzarCorazones();
    } else {
      titulo.textContent = '¿Segura, Ana? 🥺';
      texto.textContent = 'Dale otra oportunidad... 🙏';
    }

    pregunta.style.display = 'none';
    respuesta.classList.add('show');
  }

  function toggleMusica() {
    const btn = document.getElementById('musicaBtn');
    if (musica.paused) {
      musica.play();
      btn.textContent = '🔊';
    } else {
      musica.pause();
      btn.textContent = '🔇';
    }
  }

  function lanzarCorazones() {
    const emojis = ['💖','💕','💗','💓','❤️','💘','💝'];
    setInterval(() => {
      const c = document.createElement('div');
      c.className = 'corazon-flotante';
      c.textContent = emojis[Math.floor(Math.random() * emojis.length)];
      c.style.left = Math.random() * 100 + 'vw';
      c.style.fontSize = (16 + Math.random() * 24) + 'px';
      c.style.animationDuration = (4 + Math.random() * 4) + 's';
      document.body.appendChild(c);
      setTimeout(() => c.remove(), 8000);
    }, 400);
  }
</script>

</body>
</html>
